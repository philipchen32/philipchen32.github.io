---
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import { getWriting } from '../lib/writing';
import { work } from '../lib/work';
import { site } from '../site.mjs';

const recent = (await getWriting(false)).slice(0, 3);
---
<Base>
  <div class="shell home">
    <section class="home-row home-intro" aria-labelledby="home-title">
      <h1 id="home-title">{site.name}</h1>
      <div class="home-bio">
        <p>I write about search, storage, and how distributed systems behave under load.</p>
        <p>{site.bio}</p>
      </div>
    </section>

    <section class="home-row home-section" aria-labelledby="recent">
      <h2 id="recent">Recent writing</h2>
      <div>
        <WritingList entries={recent} />
        {recent.length > 0 && <a class="archive-link" href="/writing/">Writing archive</a>}
      </div>
    </section>

    {work.length > 0 && <section class="home-row home-section" aria-labelledby="work">
      <h2 id="work">Talks</h2>
      <ul class="work-list" role="list">
        {work.map(({ title, year, description, links }) => (
          <li class="work-item">
            <div class="work-heading">
              <h3>{title}</h3>
              <span class="mono">{year}</span>
            </div>
            <p>{description}</p>
            <ul class="work-links" role="list">
              {links.map(({ label, url }) => <li><a href={url}>{label}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>}
  </div>
</Base>
