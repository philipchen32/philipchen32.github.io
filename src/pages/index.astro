---
import Base from '../layouts/Base.astro';
import RetrievalArt from '../components/RetrievalArt.astro';
import WritingList from '../components/WritingList.astro';
import { getWriting } from '../lib/writing';
import { work } from '../lib/work';
import { site } from '../site.mjs';

const recent = (await getWriting(false)).slice(0, 3);
---
<Base>
  <div class="shell">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="accent"></span> Engineering notes</p>
        <h1 id="home-title">{site.name}</h1>
        <p class="intro">{site.bio}</p>
        <div class="hero-links">
          <a class="button" href="/writing/">Browse writing <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/about/">About me <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <RetrievalArt />
    </section>

    <section class="home-section" aria-labelledby="recent">
      <div class="section-heading">
        <h2 id="recent">Recent writing</h2>
        <a class="text-link" href="/writing/">All writing <span aria-hidden="true">→</span></a>
      </div>
      <WritingList entries={recent} />
    </section>

    {work.length > 0 && <section class="home-section work-section" aria-labelledby="work">
      <div class="section-heading"><h2 id="work">Selected work</h2></div>
      <ul class="work-grid" role="list">
        {work.map(({ title, description, source, url }) => (
          <li class="work-card">
            <p class="mono work-source">{source}</p>
            <h3><a href={url}>{title} <span aria-hidden="true">↗</span></a></h3>
            <p>{description}</p>
          </li>
        ))}
      </ul>
    </section>}
  </div>
</Base>
