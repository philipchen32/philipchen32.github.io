---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getWriting } from '../../lib/writing';
import { pageMeta } from '../../lib/page-meta';
const entries = await getWriting();
const { description } = pageMeta.writing;
---
<Base title="Writing" {description} image="/social/writing.png">
  <div class="shell page-space">
    <header class="page-heading">
      <span class="accent" aria-hidden="true"></span>
      <h1>Writing</h1>
      <p>{description}</p>
    </header>
    <section aria-label="Writing archive">
      <WritingList entries={entries} heading="h2" />
    </section>
  </div>
</Base>
