---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import { site } from '../site.mjs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  article?: { published: Date; updated?: Date; tags: string[] };
}

const { title, description = site.description, image = '/social/default.png',
  imageAlt = title ? `${title} · ${site.name}` : site.name, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);
const socials = site.social.filter(({ url }) => url);
const links = [{ label: 'Writing', href: '/writing/' }, { label: 'About', href: '/about/' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>}
    {import.meta.env.PROD && site.analytics.scriptUrl && site.analytics.domain &&
      <script is:inline defer src={site.analytics.scriptUrl} data-domain={site.analytics.domain}></script>
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="identity" href="/">{site.name}</a>
        <nav aria-label="Main navigation">
          {links.map(({ label, href }) => (
            <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? (Astro.url.pathname === href ? 'page' : 'location') : undefined}>{label}</a>
          ))}
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="identity" href="/">{site.name}</a>
        <nav aria-label="Follow and contact">
          <a href="/rss.xml">RSS</a>
          {socials.map(({ label, url }) => <a href={url}>{label}</a>)}
          {site.email && <a href={`mailto:${site.email}`}>Email</a>}
          {site.newsletterUrl && <a href={site.newsletterUrl}>Subscribe by email</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>
