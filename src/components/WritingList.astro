---
import { formatDate, writingUrl, type WritingEntry } from '../lib/writing';

interface Props { entries: WritingEntry[]; heading?: 'h2' | 'h3' }
const { entries, heading: Heading = 'h3' } = Astro.props;
---
{entries.length ? (
  <ul class="writing-list" role="list">
    {entries.map(({ id, data }) => (
      <li class="writing-row">
        <div class="entry-heading">
          <Heading><a href={writingUrl(id)}>{data.title}</a></Heading>
          <time class="mono" datetime={data.published.toISOString()}>{formatDate(data.published)}</time>
        </div>
        <p class="entry-description">{data.description}</p>
        <ul class="entry-meta" aria-label="Type and topics" role="list">
          <li>{data.draft ? `Draft · ${data.type}` : data.type}</li>
          {data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </li>
    ))}
  </ul>
) : <p class="empty-state">New articles and notes will appear here. You can <a href="/rss.xml">follow along by RSS</a>.</p>}
